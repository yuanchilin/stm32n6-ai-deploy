# 跨平台换行符规范化设置
# 针对 Windows 开发者（Win11 + WSL）的配置

# 默认：所有文本文件自动规范化换行符
* text=auto

# PowerShell 脚本使用 CRLF（Windows 原生）
*.ps1 text eol=crlf

# Shell 脚本使用 LF（WSL/Linux 原生）
*.sh text eol=lf

# Python/Markdown 等跨平台文件使用 LF（Git 推荐）
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Git 相关文件使用 LF
.gitignore text eol=lf
.gitattributes text eol=lf

# Makefile 必须使用 LF（否则 make 会报错）
Makefile text eol=lf
*.mk text eol=lf
*.cmake text eol=lf

# C/C++ 源代码（STM32CubeIDE）使用 LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.S text eol=lf
*.ld text eol=lf

# 二进制文件 - 不进行任何转换
*.onnx binary
*.bin binary
*.hex binary
*.elf binary
*.o binary
*.a binary
*.lib binary
*.dll binary
*.exe binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# 模型文件
*.onnx binary